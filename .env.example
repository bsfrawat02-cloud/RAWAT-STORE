# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GMAIL OTP & EMAIL CONFIGURATION (Optional for live direct Gmail SMTP delivery)
# For real Gmail OTP delivery, generate a 16-character Google App Password from:
# https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Or custom SMTP host configuration:
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SUPABASE CONFIGURATION
# Client-side Supabase URL & Public Anon Key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side Supabase keys (Optional for backend admin tasks)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

